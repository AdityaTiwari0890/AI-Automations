    {
      "parameters": {
        "jsCode": "let text = $json.output || \"\";\n\n// 1. Remove markdown code block wrappers like ```json and ```\ntext = text.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\n// 2. Extract the main JSON object\nconst jsonMatch = text.match(/\\{[\\s\\S]*\\}/);\n\nif (jsonMatch) {\n  try {\n    let rawJsonString = jsonMatch[0];\n\n    // 3. Fix unescaped newlines inside strings so JSON.parse won't crash\n    rawJsonString = rawJsonString.replace(/(?<=:\\s*\"[^\"]*)\\n(?=[^\"]*\")/g, \"\\\\n\");\n\n    const parsed = JSON.parse(rawJsonString);\n\n    return {\n      json: {\n        score: parsed.score,\n        coverLetter: parsed.coverLetter\n      }\n    };\n  } catch (e) {\n    // Fallback: If JSON parsing still fails, safely extract values using Regex\n    const scoreMatch = text.match(/\"score\"\\s*:\\s*(\\d+)/);\n    const coverLetterMatch = text.match(/\"coverLetter\"\\s*:\\s*\"([\\s\\S]*?)\"\\s*\\}/);\n\n    return {\n      json: {\n        score: scoreMatch ? parseInt(scoreMatch[1]) : null,\n        coverLetter: coverLetterMatch ? coverLetterMatch[1].replace(/\\n/g, \" \") : text\n      }\n    };\n  }\n} else {\n  throw new Error(\"No JSON object found in AI response.\");\n}"
      },
